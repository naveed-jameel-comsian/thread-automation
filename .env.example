# Set to true to scan source accounts
AUTOMATION=true

# Set to true to auto-repost (v1 posting flow). false = monitor + alerts only
POSTING_ENABLED=false

# Dashboard version: v1 (posting accounts UI) or v2 (scanner + alerts UI)
DASHBOARD_VERSION=v2

# Dashboard port
PORT=3000

# Minutes between source-account scans (default: 10)
POLL_INTERVAL_MINUTES=10

# Kameleo Local API
KAMELEO_API_URL=http://localhost:5050
KAMELEO_SCANNER_PROFILE_ID=1556bbd8-7c8a-47a9-bfe7-4dba4cd348db

# Set to false to use Playwright browser-data instead of Kameleo for posting
# USE_KAMELEO=true

# --- Alerts (configure one or more) ---

# Slack incoming webhook
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Generic JSON webhook (Zapier, Make, custom)
# ALERT_WEBHOOK_URL=https://example.com/webhook

# Email via SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# ALERT_EMAIL_FROM=you@gmail.com
# ALERT_EMAIL_TO=alerts@example.com
